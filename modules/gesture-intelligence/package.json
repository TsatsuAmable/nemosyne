{
  "name": "@nemosyne/gesture-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone pluggable gesture intelligence: trajectory features, heuristic + ONNX classification with honest provenance, biomechanical calibration, and on-device personalization. Zero host dependencies (no three.js).",
  "main": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests demo training --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build --config demo/vite.config.ts",
    "demo": "vite --config demo/vite.config.ts",
    "generate:dataset": "tsx training/generate_dataset.ts",
    "train": "tsx training/train.ts"
  },
  "peerDependencies": {
    "onnxruntime-web": ">=1.19"
  },
  "peerDependenciesMeta": {
    "onnxruntime-web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^9.20.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.14.0",
    "onnxruntime-web": "^1.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.10"
  },
  "license": "MIT"
}
