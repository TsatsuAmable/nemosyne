{
  "name": "nemosyne",
  "version": "1.0.0-alpha.1",
  "description": "A WebXR spatial data analysis suite built on three.js. Transform multi-dimensional datasets into interactive 3D memory palaces.",
  "type": "module",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "setup:mac": "bash scripts/setup-mac.sh",
    "setup:linux": "bash scripts/setup-linux.sh",
    "setup:windows": "powershell -ExecutionPolicy Bypass -File scripts/setup-windows.ps1",
    "wasm": "node scripts/build-wasm.mjs",
    "wasm:dev": "node scripts/build-wasm.mjs --dev",
    "build:wasm": "node scripts/build-wasm.mjs",
    "dev": "vite --host",
    "dev:wasm": "npm run wasm:dev && vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "lint": "eslint src tests --ext .js,.mjs,.ts",
    "lint:fix": "eslint src tests --ext .js,.mjs,.ts --fix",
    "format": "prettier --write \"src/**/*.{js,mjs,ts}\" \"tests/**/*.{js,mjs,ts}\"",
    "format:check": "prettier --check \"src/**/*.{js,mjs,ts}\" \"tests/**/*.{js,mjs,ts}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:all": "node scripts/cargo-test.mjs && vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run tests/e2e",
    "test:e2e:tier1": "vitest run tests/e2e/tier1_feature_coverage",
    "test:e2e:tier2": "vitest run tests/e2e/tier2_boundary_corner",
    "test:e2e:tier3": "vitest run tests/e2e/tier3_cross_feature",
    "test:e2e:tier4": "vitest run tests/e2e/tier4_real_world",
    "test:smoke": "playwright test",
    "test:smoke:install": "playwright install --with-deps chromium",
    "deploy:netlify": "npm run build && npx netlify deploy --prod --dir=dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.62.1",
    "@types/three": "^0.185.4",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.20.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-vitest": "^0.5.4",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "marked": "^18.0.7",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wasm-pack": "^0.15.0"
  },
  "keywords": [
    "webxr",
    "three.js",
    "vr",
    "data-visualization",
    "spatial-analysis",
    "memory-palace",
    "nemosyne"
  ],
  "license": "MIT",
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "apache-arrow": "^21.2.0",
    "three": "^0.168.0",
    "ws": "^8.17.0"
  }
}
