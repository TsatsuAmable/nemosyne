{
  "name": "nemosyne",
  "version": "1.0.0-alpha.1",
  "description": "A WebXR spatial data analysis suite built on three.js. Transform multi-dimensional datasets into interactive 3D memory palaces.",
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build wasm --target web --out-dir pkg",
    "wasm:dev": "wasm-pack build wasm --target web --out-dir pkg --dev",
    "build:wasm": "wasm-pack build wasm --target web --out-dir pkg",
    "dev": "npm run wasm:dev && vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "lint": "eslint src tests --ext .js,.mjs",
    "lint:fix": "eslint src tests --ext .js,.mjs --fix",
    "format": "prettier --write \"src/**/*.{js,mjs}\" \"tests/**/*.{js,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{js,mjs}\" \"tests/**/*.{js,mjs}\"",
    "test": "cargo test --manifest-path wasm/Cargo.toml && vitest run",
    "test:coverage": "vitest run --coverage",
    "deploy:netlify": "npm run build && npx netlify deploy --prod --dir=dist",
    "deploy:vercel": "npm run build && npx vercel --prod"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@msgpack/msgpack": "^3.1.3",
    "@vitest/coverage-v8": "^4.1.10",
    "apache-arrow": "^21.2.0",
    "eslint": "^9.20.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-vitest": "^0.5.4",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "marked": "^18.0.7",
    "prettier": "^3.5.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "ws": "^8.17.0"
  },
  "keywords": [
    "webxr",
    "three.js",
    "vr",
    "data-visualization",
    "spatial-analysis",
    "memory-palace",
    "nemosyne"
  ],
  "license": "MIT",
  "dependencies": {
    "three": "^0.168.0"
  }
}
