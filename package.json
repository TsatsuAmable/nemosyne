{
  "name": "nemosyne",
  "version": "1.0.0-alpha.1",
  "description": "A WebXR spatial data analysis suite built on three.js. Transform multi-dimensional datasets into interactive 3D memory palaces.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "deploy:netlify": "npm run build && npx netlify deploy --prod --dir=dist",
    "deploy:vercel": "npm run build && npx vercel --prod"
  },
  "devDependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@vitest/coverage-v8": "^4.1.10",
    "apache-arrow": "^21.2.0",
    "flatbuffers": "^25.9.23",
    "jsdom": "^29.1.1",
    "tslib": "^2.8.1",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "ws": "^8.17.0"
  },
  "keywords": [
    "webxr",
    "three.js",
    "vr",
    "data-visualization",
    "spatial-analysis",
    "memory-palace",
    "nemosyne"
  ],
  "license": "MIT",
  "dependencies": {
    "three": "^0.168.0"
  }
}
